        <mxCell id="querysvc" value="&lt;b&gt;QueryTransactionsService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;filtros + paginación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="550" y="275" width="185" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sweeper" value="&lt;b&gt;StalePendingSweeper&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;@Scheduled: PENDING → UNKNOWN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="550" y="355" width="185" height="60" as="geometry" />
        </mxCell>

