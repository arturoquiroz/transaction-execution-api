        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;→ línea sólida: llamada / dependencia&lt;br&gt;⇢ línea punteada con triángulo vacío: implementa el puerto&lt;br&gt;&lt;b&gt;Regla de dependencias:&lt;/b&gt; los adaptadores dependen del núcleo; el núcleo nunca conoce a los adaptadores." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;whiteSpace=wrap;strokeColor=#CCCCCC;fillColor=#FFFFFF;spacing=8;rounded=1;" vertex="1" parent="1">
