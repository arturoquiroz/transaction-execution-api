        <mxCell id="tx" value="&lt;b&gt;Transaction&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(agregado)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PENDING → EXECUTED | REJECTED&lt;br&gt;| FAILED | UNKNOWN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="550" y="500" width="185" height="75" as="geometry" />
