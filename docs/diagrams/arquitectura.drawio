        <mxCell id="policy" value="&lt;b&gt;TransactionPolicy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;monto mínimo · tope de débito&lt;br&gt;· moneda soportada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="550" y="600" width="185" height="70" as="geometry" />
