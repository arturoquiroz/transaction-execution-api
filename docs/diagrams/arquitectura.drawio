<mxfile host="app.diagrams.net" type="device">
  <diagram id="arquitectura" name="Arquitectura">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title ===== -->
        <mxCell id="title" value="&lt;b&gt;Transaction Execution API&lt;/b&gt; — Arquitectura de componentes (hexagonal)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F2A44;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Client ===== -->
        <mxCell id="client" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Postman / servicio consumidor&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="85" y="380" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- ===== API boundary ===== -->
        <mxCell id="api" value="&lt;b&gt;Transaction Execution API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Java 25 · Spring Boot 4.1 · virtual threads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#1F2A44;strokeWidth=2;verticalAlign=top;align=center;fontColor=#1F2A44;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="60" width="1060" height="700" as="geometry" />
        </mxCell>

        <!-- ===== Inbound adapters ===== -->
        <mxCell id="in" value="&lt;b&gt;Adaptadores de entrada&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF1FB;strokeColor=#6C8EBF;verticalAlign=top;fontColor=#1F2A44;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="220" height="590" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;TransactionController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /transactions&lt;br&gt;GET /transactions · /{id}&lt;br&gt;Bean Validation (forma)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="handler" value="&lt;b&gt;ApiExceptionHandler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Errores RFC 9457&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="500" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reqid" value="&lt;b&gt;RequestIdFilter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;X-Request-Id → logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Core ===== -->
        <mxCell id="core" value="&lt;b&gt;Núcleo&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(sin dependencias de web ni SQL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#82B366;dashed=1;strokeWidth=2;verticalAlign=top;fontColor=#1F2A44;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="515" y="100" width="450" height="640" as="geometry" />
        </mxCell>

        <!-- Application -->
        <mxCell id="app" value="&lt;b&gt;Aplicación&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(casos de uso)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFF8E1;strokeColor=#D6B656;verticalAlign=top;fontColor=#1F2A44;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="535" y="140" width="215" height="300" as="geometry" />
        </mxCell>
        <mxCell id="execsvc" value="&lt;b&gt;ExecuteTransactionService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;idempotencia → reglas → PENDING&lt;br&gt;→ proveedor → estado final&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="550" y="180" width="185" height="75" as="geometry" />
