        <mxCell id="repoport" value="&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;TransactionRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="785" y="280" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="provport" value="&lt;i&gt;«interface»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ExecutionProvider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ ProviderOutcome (sealed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="785" y="490" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Outbound adapters ===== -->
        <mxCell id="out" value="&lt;b&gt;Adaptadores de salida&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF4E6;strokeColor=#D79B00;verticalAlign=top;fontColor=#1F2A44;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="270" height="590" as="geometry" />
        </mxCell>
        <mxCell id="jdbc" value="&lt;b&gt;JdbcTransactionRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;JdbcClient · SQL explícito&lt;br&gt;Liquibase · HikariCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="270" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="http" value="&lt;b&gt;HttpExecutionProvider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RestClient · timeouts (1 s / 3 s)&lt;br&gt;Resilience4j: circuit breaker,&lt;br&gt;retry solo en error de conexión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="475" width="230" height="100" as="geometry" />
