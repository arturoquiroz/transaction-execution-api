        <mxCell id="prov" value="&lt;b&gt;Proveedor externo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;saldos y bloqueos&lt;br&gt;(simulado con WireMock)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
