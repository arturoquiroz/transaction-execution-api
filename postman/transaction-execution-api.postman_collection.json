{
  "info": {
    "name": "Transaction Execution API",
    "description": "Every scenario of LLD \u00a710. Run the whole collection with the Collection Runner (or newman); set baseUrl to the target environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "replayKey",
      "value": ""
    },
    {
      "key": "replayedId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh Idempotency-Key per request, unless the request uses {{replayKey}} on purpose",
          "pm.variables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Credit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": \"acc-postman\", \"type\": \"CREDIT\", \"amount\": 1500.00, \"currency\": \"MXN\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status = EXECUTED\", () => pm.expect(pm.response.json().status).to.eql(\"EXECUTED\"));",
                  "pm.test(\"Location header\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"transactionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": \"acc-postman\", \"type\": \"DEBIT\", \"amount\": 1500.00, \"currency\": \"MXN\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status = EXECUTED\", () => pm.expect(pm.response.json().status).to.eql(\"EXECUTED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit exactly at the limit (10000.00)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"accountId\": \"acc-postman\", \"type\": \"DEBIT\", \"amount\": 10000.00, \"currency\": \"MXN\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status = EXECUTED\", () => pm.expect(pm.response.json().status).to.eql(\"EXECUTED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
