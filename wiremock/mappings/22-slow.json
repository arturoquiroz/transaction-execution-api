{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "bodyPatterns": [{"matchesJsonPath": "$[?(@.accountId == 'acc-slow')]"}]
  },
  "response": {"status": 200, "fixedDelayMilliseconds": 5000, "headers": {"Content-Type": "application/json"}, "jsonBody": {"transactionId": "txn-{{randomValue length=10 type='ALPHANUMERIC'}}", "status": "APPROVED", "balance": 5500.00, "executedAt": "{{now}}"}, "transformers": ["response-template"]}
}
