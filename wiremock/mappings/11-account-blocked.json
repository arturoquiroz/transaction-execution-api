{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "bodyPatterns": [{"matchesJsonPath": "$[?(@.accountId == 'acc-blocked')]"}]
  },
  "response": {"status": 403, "headers": {"Content-Type": "application/json"}, "jsonBody": {"status": "REJECTED", "code": "ACCOUNT_BLOCKED", "message": "The account is blocked"}}
}
